# --- Core infrastructure ---
# Inside docker compose these hostnames resolve to the postgres/redis services.
DATABASE_URL=postgresql+psycopg://nextix:nextix@postgres:5432/nextix
REDIS_URL=redis://redis:6379/0

# --- Claude ---
# nexTix can pay for Claude two ways; set one or both.
#
# 1. Your Claude Pro/Max plan (personal use only, never for other people's requests).
#    Create a one-year token with `claude setup-token` and paste it here. Triage and
#    agent runs then go through Claude Code and count against your plan's usage limits.
CLAUDE_CODE_OAUTH_TOKEN=
# 2. A Claude Console API key, billed per use. Required if nexTix is shared with others.
ANTHROPIC_API_KEY=
# Which one to use: auto (the plan token when set, else the API key) | subscription | api_key
NEXTIX_CLAUDE_AUTH=auto
ANTHROPIC_MODEL=claude-opus-5

# --- GitHub App (see README: "Creating the GitHub App") ---
GITHUB_APP_ID=
# Client ID (Iv23li...). GitHub recommends it as the JWT issuer; falls back to GITHUB_APP_ID.
GITHUB_APP_CLIENT_ID=
# Put the downloaded key at ./secrets/github-app.pem; compose mounts ./secrets here.
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_BOT_LOGIN=nextix-bot[bot]

# --- nexTix ---
# Bearer token for the CLI, and the password for the web login. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXTIX_API_TOKEN=change-me
NEXTIX_PUBLIC_URL=http://localhost:3000
# Besides the repo owner, GitHub users (comma-separated) whose `nextix` label starts an
# agent run. Anyone else can label an issue; it shows on the board but no agent starts.
NEXTIX_ALLOWED_GITHUB_USERS=

# --- Agent sandbox (Phase 3) ---
# Build the image once with `docker compose build agent` (and again after changing
# agent-image/). Each run gets its own container from it, removed when the run ends.
AGENT_IMAGE=nextix-agent:latest
AGENT_DEFAULT_TIMEOUT_MIN=30
# The run stops when Claude Code's cost estimate reaches this. On a Claude plan nothing is
# billed per run; the estimate still caps how much of your allowance one run can use.
AGENT_DEFAULT_MAX_COST_USD=3
AGENT_MAX_TURNS=60
AGENT_ALLOWED_TOOLS=Read,Edit,Write,Bash,Glob,Grep
# Per-sandbox limits.
AGENT_MEM_LIMIT=4g
AGENT_CPUS=2
ARTIFACT_DIR=/data/artifacts

# --- Web (only needed when running `npm run dev` outside compose) ---
API_INTERNAL_URL=http://localhost:8000

# --- docker compose host ports (change if 3000/8000 are taken on your machine) ---
WEB_PORT=3000
API_PORT=8000
