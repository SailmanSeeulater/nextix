# --- Core infrastructure ---
# Inside docker compose these hostnames resolve to the postgres/redis services.
DATABASE_URL=postgresql+psycopg://nextix:nextix@postgres:5432/nextix
REDIS_URL=redis://redis:6379/0

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- GitHub App (Phase 1) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_BOT_LOGIN=nextix-bot[bot]

# --- nexTix ---
NEXTIX_API_TOKEN=change-me
NEXTIX_PUBLIC_URL=http://localhost:3000
NEXTIX_ALLOWED_GITHUB_USERS=

# --- Agent sandbox (Phase 3) ---
AGENT_IMAGE=nextix-agent:latest
AGENT_DEFAULT_TIMEOUT_MIN=30
AGENT_DEFAULT_MAX_COST_USD=3
ARTIFACT_DIR=/data/artifacts

# --- Web ---
# Browser-side base URL of the API (used by the Next.js app when run outside compose).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- docker compose host ports (change if 3000/8000 are taken on your machine) ---
WEB_PORT=3000
API_PORT=8000
